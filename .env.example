# Copy to .env and fill in. NEVER commit the real .env.

# Mongo
MONGO_URI=mongodb://localhost:27017/task-manager

# Server
PORT=5000

# Auth — use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Practical 9 (caching)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Practical 10 (event listeners) — delay makes the async ordering visible in the console
NOTIFICATION_DELAY_MS=2000

# Frontend (Vite only exposes VITE_* to the browser). Must match PORT above.
VITE_API_URL=http://localhost:5000